{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lampcircle",
  "version": "0.1.0",
  "identifier": "app.truefrontier.lampcircle",
  "build": {
    "beforeDevCommand": "npm run dev:client -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lampcircle",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 36 },
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczODY3MDU2MTE3MUU0QTIKUldTaTVIRVJWbkNHYzc3K2JXZkFvaVRLa0ttdGs1VnhhZ2NrUG9TZUVuQ0hRTmdueEFOSi9RWU4K",
      "endpoints": [
        "https://lampcircle-feedback.fly.dev/updates/latest.json?version={{current_version}}&target={{target}}&arch={{arch}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
